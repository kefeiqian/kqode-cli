{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KQode",
  "version": "0.1.3",
  "identifier": "ai.kqode.desktop",
  "mainBinaryName": "kqode-desktop",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "frontend"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "frontend"
    },
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "KQode",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
